      "resolved": "apps/mcp",
      "link": true
    },
    "packages/contracts": {
      "name": "@rotazfm/contracts",
      "version": "0.1.0"
    },
    "packages/domain": {
      "name": "@rotazfm/domain",
      "version": "0.1.0"
    },
    "packages/ingestion": {
      "name": "@rotazfm/ingestion",
