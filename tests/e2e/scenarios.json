{
  "version": "2026-11-23",
  "rule_version": "iav-mvp-2026-11-23",
  "source": "docs/TEST_PLAN.md",
  "constraints": {
    "no_product_code": true,
    "no_paid_external_apis": true,
    "fixtures_are_local": true,
    "llm_never_calculates_iav": true
  },
  "field_contract": {
    "input": "IavQuery para api/mcp; mesmo formulário para dashboard; route_id somente em cenários de catálogo.",
    "fixtures": "IDs lógicos de fixtures locais; devem ser materializados em data/fixtures sem chamar APIs pagas.",
    "expected_status": "Pior status entre as rotas avaliadas; em erro de borda usa INVALID_QUERY, ROUTE_NOT_FOUND, UNAUTHORIZED ou RATE_LIMITED; em dashboard sem dados usa EMPTY_STATE.",
    "expected_iav": "Inteiro 0..100 quando há score numérico esperado; null quando expected_null é true. Valores inteiros são alvos de fixture até os normalizadores serem implementados.",
    "expected_null": "true exige iav=null e ausência de score parcial ou aprovação implícita.",
    "expected_blockers": "Bloqueadores confirmados; notícia sem CONFIRMADO nunca aparece aqui.",
    "expected_missing_data": "Lacunas auditáveis com dimensão, trecho e motivo.",
    "expected_route_assessments": "Detalhe por rota quando o cenário depende de mais de uma rota ou de pior trecho."
  },
  "status_values": [
    "VIAVEL",
    "VIAVEL_COM_RESSALVAS",
    "NAO_VIAVEL",
    "NAO_AVALIAVEL",
    "INVALID_QUERY",
    "ROUTE_NOT_FOUND",
    "UNAUTHORIZED",
    "RATE_LIMITED",
    "EMPTY_STATE"
  ],
  "scenarios": [
    {
      "id": "C01",
      "title": "Consulta válida com dados frescos",
      "category": "success",
      "surface": "api",
      "input": {
        "origem": "MANAUS",
        "destino": "SAO_PAULO",
        "data_embarque": "2026-11-25",
        "carga": {
          "tipo": "SECA",
          "peso_bruto_total_kg": 10000,
          "quantidade_caminhoes": 1
        }
      },
      "fixtures": ["c01-fresh-baseline"],
      "expected_http_status": 200,
      "expected_status": "VIAVEL_COM_RESSALVAS",
      "expected_iav": 64,
      "expected_null": false,
      "expected_blockers": [],
      "expected_missing_data": [],
      "expected_route_assessments": {
        "rota-1-br-319": {
          "status": "VIAVEL",
          "iav": 76,
          "worst_segment_id": "r1-s2-floresta-br319"
        },
        "rota-2-fluvial-brasilia": {
          "status": "VIAVEL_COM_RESSALVAS",
          "iav": 64,
          "worst_segment_id": "r2-s1-fluvial-amazonas"
        }
      },
      "notes": "Caminho feliz com as cinco dimensões frescas e confirmadas; a rota é consolidada pelo pior trecho."
    },
