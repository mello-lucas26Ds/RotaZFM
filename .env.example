# RotaZFM — variáveis de ambiente (exemplo; nunca commitar .env real)

# Banco de dados local/MVP
DATABASE_URL=postgres://rotazfm:rotazfm@localhost:5432/rotazfm

# API e MCP
API_PORT=3001
MCP_PORT=3002
# Chaves aceitas no header Authorization: Bearer <key>; separar por vírgula
IAV_MCP_API_KEYS=dev-key-change-me
# URL pública da API usada apenas em integrações externas; o dashboard serverless usa rotas internas /api/v1/*
NEXT_PUBLIC_API_URL=http://localhost:3001
# Token Bearer digitado pelo usuário no dashboard e exigido nas rotas serverless quando configurado
DASHBOARD_AUTH_TOKEN=

# Coleta e evidências
# Nível do rio: boletim público ANA gov.br/PDF via scripts/extract-ana-boletim.py; não há credencial ANA.
# Firecrawl/Alexandria: necessária para descoberta/filtro de notícias e scraping seletivo.
# Sem a chave, o sistema deve rodar apenas com fixtures locais.
FIRECRAWL_API_KEY=

# Opcional após spike: somente se routekit/distância dinâmica forem aprovados
ROUTEKIT_API_KEY=

# Deploy final na Vercel (não usar em runtime do app; apenas CLI/deploy)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
